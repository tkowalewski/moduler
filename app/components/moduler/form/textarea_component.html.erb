<div class="mt-2">
  <% if @options.key?(:label) %>
    <%= @form.label @name, @options[:label], class: "block text-sm text-slate-500" %>
  <% end %>
  <div class="mt-2">
    <%= @form.text_area @name, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900" %>
  </div>
  <% if @options.key?(:description) %>
    <p class="mt-1 text-xs text-gray-400"><%= @options[:description] %></p>
  <% end %>
  <% if @form.error?(@name) %>
    <%= @form.error(@name, class: "text-red-500 text-sm mt-1") %>
  <% end %>
</div>
