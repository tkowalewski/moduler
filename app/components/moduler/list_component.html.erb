<div class="mt-6 flex-1">
  <% if @collection.any? %>
    <ul id="<%= @options[:id] %>" role="list" class="divide-y divide-slate-100 rounded-lg border border-slate-200 bg-white">
      <%= content %>
    </ul>
  <% else %>
    <p class="rounded-lg border border-dashed border-slate-300 px-4 py-8 text-center text-sm text-slate-500"><%= empty_message %></p>
  <% end %>
</div>

<% if paginated? %>
  <div class="mt-4 flex justify-end">
    <%= helpers.paginate @collection %>
  </div>
<% end %>
