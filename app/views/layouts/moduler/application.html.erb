<!DOCTYPE html>
<html>
  <head>
    <title>Moduler</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= stylesheet_link_tags_if_exist "moduler/tailwind", "moduler/application", media: "all" %>

    <%# Include host application stylesheets %>
    <%= stylesheet_link_tags_if_exist "tailwind", "application", media: "all" %>

    <%= javascript_importmap_tags "moduler/application" %>
  </head>
  <body class="flex min-h-screen flex-col">
    <div class="flex flex-1 flex-col">
      <%= render "moduler/common/header" if authenticated? %>
      <%= render "moduler/common/flash" if authenticated? %>

      <%= yield %>
    </div>
  </body>
</html>
