<main class="mx-auto flex w-full flex-1 max-w-[120rem] flex-col gap-4 px-4 md:flex-row md:gap-8 md:pl-0 md:pr-6">
  <%= render "moduler/common/profile/sidebar" %>

  <div class="flex min-w-0 flex-1 flex-col pb-4 md:mt-8">
    <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <h1 class="text-base font-semibold text-gray-900"><%= t(".title") %></h1>
        <p class="mt-1 text-sm text-slate-500"><%= t(".description") %></p>
      </div>

      <%= button_to t(".action.revoke_all"), moduler.profile_sessions_revocation_path, method: :delete,
            class: "cursor-pointer whitespace-nowrap rounded-md bg-white px-3 py-1.5 text-sm/6 font-semibold text-red-600 shadow-sm ring-1 ring-inset ring-slate-300 hover:bg-red-50 hover:ring-red-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600",
            form: { class: "shrink-0", data: { turbo_confirm: t(".confirmation.revoke") } } %>
    </div>

    <div class="flex-1">
      <ul id="sessions" role="list" class="divide-y divide-slate-100 rounded-lg border border-slate-200 bg-white">
        <%= render partial: "moduler/profile/sessions/session", collection: @sessions %>
      </ul>
    </div>

    <div class="mt-4 flex justify-end">
      <%= paginate @sessions %>
    </div>
  </div>
</main>
