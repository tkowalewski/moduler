<main class="mx-auto flex w-full flex-1 max-w-[120rem] flex-col gap-4 px-4 md:flex-row md:gap-8 md:pl-0 md:pr-6">
  <%= render "moduler/common/sidebar" %>

  <div class="flex min-w-0 flex-1 flex-col pb-4 md:mt-8">
    <div class="mb-4 flex min-h-9 items-center justify-between gap-4">
      <h1 class="text-base font-semibold text-gray-900"><%= t(".title") %></h1>

      <%= button_to t(".action.revoke_all"), moduler.profile_sessions_revocation_path, method: :delete,
            class: "cursor-pointer rounded-md bg-custom px-3 py-1.5 text-sm/6 font-semibold text-white shadow-sm hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-custom",
            form: { data: { turbo_confirm: t(".confirmation.revoke") } } %>
    </div>

    <div class="flex-1 overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-slate-200 text-xs uppercase tracking-wide text-slate-400">
          <tr>
            <th class="py-1.5 pr-4 font-medium"><%= t(".header.signed_in") %></th>
            <th class="py-1.5 pr-4 font-medium"><%= t(".header.ip") %></th>
            <th class="hidden py-1.5 pr-4 font-medium md:table-cell"><%= t(".header.user_agent") %></th>
            <th class="py-1.5 pr-4 font-medium"><%= t(".header.status") %></th>
            <th class="py-1.5 pr-4"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <%= render partial: "moduler/profile/sessions/session", collection: @sessions %>
        </tbody>
      </table>
    </div>

    <div class="mt-4 flex justify-end">
      <%= paginate @sessions %>
    </div>
  </div>
</main>
