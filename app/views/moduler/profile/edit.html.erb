<main class="mx-auto flex w-full flex-1 max-w-[120rem] flex-col gap-4 px-4 md:flex-row md:gap-8 md:pl-0 md:pr-6">
  <%= render "moduler/common/profile/sidebar" %>

  <div class="flex min-w-0 flex-1 flex-col pb-4 md:mt-8">
    <div class="mb-4 flex min-h-9 items-center justify-between gap-4">
      <h1 class="text-base font-semibold text-gray-900"><%= t(".title") %></h1>
    </div>

    <%= form_with model: @user, url: moduler.profile_path, method: :patch, data: { turbo: false }, class: "w-full max-w-lg space-y-6" do |form| %>
      <%= render(::Moduler::Form::BaseErrorComponent.new(form)) %>

      <%= render(::Moduler::Form::SectionComponent.new(t(".section.data"))) do %>
        <%= render(::Moduler::Form::EmailComponent.new(form, :email_address, label: t(".label.email_address"), disabled: :disabled)) %>
      <% end %>

      <%= render(::Moduler::Form::SectionComponent.new(t(".section.password"), divider: true)) do %>
        <%= render(::Moduler::Form::PasswordComponent.new(form, :password, label: t(".label.password"))) %>
        <%= render(::Moduler::Form::PasswordComponent.new(form, :password_confirmation, label: t(".label.password_confirmation"), description: t(".description.password_confirmation"))) %>
      <% end %>

      <%= render(::Moduler::Form::SectionComponent.new(t(".section.current_password"), divider: true)) do %>
        <%= render(::Moduler::Form::PasswordComponent.new(form, :password_challenge, label: t(".label.password_challenge"), description: t(".description.password_challenge"))) %>
      <% end %>

      <%= render(::Moduler::Form::SubmitComponent.new(form, text: t(".action.save"))) %>
    <% end %>
  </div>
</main>
