<main class="mx-auto flex w-full flex-1 max-w-[120rem] flex-col gap-4 px-4 md:flex-row md:gap-8 md:pl-0 md:pr-6">
  <%= render "moduler/common/profile/sidebar" %>

  <div class="flex min-w-0 flex-1 flex-col pb-4 md:mt-8">
    <%= render(Moduler::PageHeaderComponent.new(t(".title"), description: t(".description"))) %>

    <%= render(Moduler::ListComponent.new(@sent_emails, id: "sent_emails", empty: t(".empty"))) do %>
      <% @sent_emails.each do |sent_email| %>
        <%= render(Moduler::ListItemComponent.new(sent_email.subject, id: dom_id(sent_email))) do |item| %>
          <% item.with_meta do %>
            <%= time_tag sent_email.created_at, l(sent_email.created_at, format: :long) %>
            <% sent_email.attachments.each do |attachment| %>
              <span aria-hidden="true">&middot;</span>
              <%= link_to attachment.filename, main_app.rails_blob_path(attachment, disposition: "attachment"), title: t(".action.download", filename: attachment.filename), class: "text-slate-500 underline hover:text-slate-900" %>
            <% end %>
          <% end %>

          <% item.with_action do %>
            <%= link_to t(".action.show"), moduler.profile_sent_email_path(sent_email), target: "_blank", rel: "noopener",
                  class: "shrink-0 rounded-md bg-white px-2.5 py-1 text-sm font-medium text-slate-600 shadow-sm ring-1 ring-inset ring-slate-300 hover:bg-slate-50 hover:text-slate-900" %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</main>
