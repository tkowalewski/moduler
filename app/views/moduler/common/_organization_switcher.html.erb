<details class="group relative p-2 pb-0 md:pb-2" data-controller="dropdown" data-action="click@window->dropdown#closeOnOutsideClick keydown.esc@window->dropdown#close">
  <summary class="flex cursor-pointer list-none items-center justify-between gap-2 rounded-md border border-gray-200 px-3 py-2 text-sm hover:bg-slate-50 [&::-webkit-details-marker]:hidden" aria-label="<%= t(".label") %>">
    <span class="min-w-0">
      <span class="block text-xs text-slate-500"><%= t(".label") %></span>
      <span class="block truncate font-medium text-gray-900"><%= current_organization.name %></span>
    </span>
    <svg class="size-4 shrink-0 text-slate-400 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
    </svg>
  </summary>

  <ul id="organization_switcher" class="absolute inset-x-2 z-10 mt-1 max-h-72 overflow-y-auto rounded-md border border-gray-200 bg-white p-1 text-sm shadow-lg">
    <% current_user.organizations.order(:name).each do |organization| %>
      <li>
        <% if organization == current_organization %>
          <span class="flex items-center justify-between gap-2 rounded-md bg-slate-100 px-3 py-2 font-medium text-gray-900" aria-current="true">
            <span class="truncate"><%= organization.name %></span>
            <svg class="size-4 shrink-0" viewBox="0 0 20 20" fill="currentColor" role="img" aria-label="<%= t(".current") %>">
              <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
            </svg>
          </span>
        <% else %>
          <%= link_to organization.name, moduler.organization_path(organization),
                class: "block truncate rounded-md px-3 py-2 text-slate-500 hover:bg-slate-50 hover:text-gray-900" %>
        <% end %>
      </li>
    <% end %>
  </ul>
</details>
