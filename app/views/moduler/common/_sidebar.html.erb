<aside class="-mx-4 border-b border-gray-200 px-2 md:mx-0 md:w-1/8 md:shrink-0 md:border-b-0 md:border-r md:px-0">
  <%= render "moduler/common/organization_switcher" %>

  <nav class="flex gap-1 overflow-x-auto md:flex-col text-sm p-2">
    <%= render(Moduler::SidebarActionComponent.new(t(".action.dashboard"), moduler.organization_path(current_organization), "moduler/organizations")) %>
    <% Moduler.configuration.resources.each do |resource| %>
      <% next if resource.permission && !can?(resource.permission) %>
      <%= render(Moduler::SidebarActionComponent.new(t(".action.#{resource.name}"), moduler.url_for([current_organization, resource.name.to_sym]), "moduler/#{resource.name}")) %>
    <% end %>
  </nav>
</aside>
