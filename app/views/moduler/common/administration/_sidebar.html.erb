<aside class="-mx-4 border-b border-gray-200 px-2 md:mx-0 md:w-1/8 md:shrink-0 md:border-b-0 md:border-r md:px-0">
  <nav class="flex gap-1 overflow-x-auto md:flex-col text-sm p-2">
    <%= render(Moduler::SidebarActionComponent.new(t(".action.users"), moduler.administration_users_path, "moduler/administration/users")) %>
    <%= render(Moduler::SidebarActionComponent.new(t(".action.sessions"), moduler.administration_sessions_path, "moduler/administration/sessions")) %>
    <%= render(Moduler::SidebarActionComponent.new(t(".action.organizations"), moduler.administration_organizations_path, "moduler/administration/organizations")) %>
    <%= render(Moduler::SidebarActionComponent.new(t(".action.roles"), moduler.administration_roles_path, "moduler/administration/roles")) %>
    <%= render(Moduler::SidebarActionComponent.new(t(".action.memberships"), moduler.administration_memberships_path, "moduler/administration/memberships")) %>

    <div role="separator" class="mx-1 w-px shrink-0 self-stretch bg-gray-200 md:mx-0 md:my-2 md:h-px md:w-auto"></div>

    <%= render(Moduler::SidebarActionComponent.new(t(".action.articles"), moduler.administration_articles_path, "moduler/administration/articles")) %>
    <%= render(Moduler::SidebarActionComponent.new(t(".action.documents"), moduler.administration_documents_path, "moduler/administration/documents")) %>
    <%= render(Moduler::SidebarActionComponent.new(t(".action.emails"), moduler.administration_emails_path, "moduler/administration/emails")) %>
    <%= render(Moduler::SidebarActionComponent.new(t(".action.preferences"), moduler.administration_preferences_path, "moduler/administration/preferences")) %>

    <div role="separator" class="mx-1 w-px shrink-0 self-stretch bg-gray-200 md:mx-0 md:my-2 md:h-px md:w-auto"></div>

    <% Moduler.configuration.administration_resources.each do |resource| %>
      <%= render(Moduler::SidebarActionComponent.new(t(".action.#{resource}"), moduler.url_for([:administration, resource.to_sym]), "moduler/administration/#{resource}")) %>
    <% end %>
  </nav>
</aside>
