<% changes = @audit_event.metadata.fetch("changes", {}) %>
<% details = @audit_event.metadata.except("changes") %>

<%= render(Moduler::Administration::PageComponent.new) do %>
  <%= render(Moduler::PageHeaderComponent.new(@audit_event.action, description: l(@audit_event.created_at, format: :long))) do |header| %>
    <% header.with_action do %>
      <%= render(Moduler::ButtonLinkComponent.new(t(".action.back"), moduler.administration_audit_events_path)) %>
    <% end %>
  <% end %>

  <dl id="event" class="grid gap-x-6 gap-y-4 rounded-lg border border-slate-200 bg-white p-4 text-sm sm:grid-cols-2 sm:p-5">
    <% { user: @audit_event.user&.email_address || t(".unknown"),
         organization: @audit_event.organization&.name || t(".none"),
         subject: audit_event_subject(@audit_event, full: true) || t(".none"),
         ip_address: @audit_event.ip_address.presence || t(".unknown"),
         request_id: @audit_event.request_id.presence || t(".unknown") }.each do |label, value| %>
      <div class="min-w-0">
        <dt class="text-xs font-medium text-slate-500"><%= t(".label.#{label}") %></dt>
        <dd class="mt-1 break-words text-gray-900"><%= value %></dd>
      </div>
    <% end %>
  </dl>

  <% if changes.any? %>
    <h2 class="mt-8 text-sm font-semibold text-gray-900"><%= t(".changes") %></h2>
    <dl id="changes" class="mt-3 divide-y divide-slate-100 rounded-lg border border-slate-200 bg-white text-sm">
      <% changes.each do |attribute, (before, after)| %>
        <div class="px-4 py-3">
          <dt class="font-medium break-words text-gray-900"><%= attribute %></dt>
          <dd class="mt-2 grid gap-2 sm:grid-cols-2">
            <div class="min-w-0 rounded-md bg-red-50 px-3 py-2 text-red-900">
              <p class="text-xs font-medium text-red-700"><%= t(".label.before") %></p>
              <p class="mt-1 whitespace-pre-wrap break-words"><%= audit_event_value(before) %></p>
            </div>
            <div class="min-w-0 rounded-md bg-green-50 px-3 py-2 text-green-900">
              <p class="text-xs font-medium text-green-700"><%= t(".label.after") %></p>
              <p class="mt-1 whitespace-pre-wrap break-words"><%= audit_event_value(after) %></p>
            </div>
          </dd>
        </div>
      <% end %>
    </dl>
  <% end %>

  <% if details.any? %>
    <h2 class="mt-8 text-sm font-semibold text-gray-900"><%= t(".details") %></h2>
    <dl id="details" class="mt-3 divide-y divide-slate-100 rounded-lg border border-slate-200 bg-white text-sm">
      <% details.each do |key, value| %>
        <div class="grid gap-1 px-4 py-2 sm:grid-cols-5 sm:gap-4">
          <dt class="font-medium text-gray-900"><%= key %></dt>
          <dd class="whitespace-pre-wrap break-words text-slate-700 sm:col-span-4"><%= audit_event_value(value) %></dd>
        </div>
      <% end %>
    </dl>
  <% end %>
<% end %>
