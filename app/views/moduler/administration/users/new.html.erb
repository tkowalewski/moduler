<%= render(Moduler::Administration::PageComponent.new) do %>
  <%= render(Moduler::PageHeaderComponent.new(t(".title"))) %>

  <%= form_with model: @user, url: moduler.administration_users_path, data: { turbo: false }, class: "w-full max-w-lg space-y-6" do |form| %>
    <%= render(::Moduler::Form::BaseErrorComponent.new(form)) %>

    <%= render(::Moduler::Form::SectionComponent.new(t(".section.data"))) do %>
      <%= render(::Moduler::Form::EmailComponent.new(form, :email_address, label: t(".label.email_address"))) %>
      <%= render(::Moduler::Form::SelectComponent.new(form, :role, Moduler::User.roles.keys.map { |role| [ t("moduler.administration.users.roles.#{role}"), role ] }, label: t(".label.role"))) %>
    <% end %>

    <%= render(::Moduler::Form::SectionComponent.new(t(".section.password"), divider: true)) do %>
      <%= render(::Moduler::Form::PasswordComponent.new(form, :password, label: t(".label.password"), description: t(".description.password"))) %>
    <% end %>

    <%= render(::Moduler::Form::SubmitComponent.new(form, text: t(".action.create"))) %>
  <% end %>
<% end %>
