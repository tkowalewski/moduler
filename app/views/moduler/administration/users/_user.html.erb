<%= render(Moduler::ListItemComponent.new(user.email_address, id: dom_id(user))) do |item| %>
  <% item.with_badge(t("moduler.administration.users.roles.#{user.role}"), variant: user.administrator? ? :success : :neutral) %>

  <% item.with_meta do %>
    <%= time_tag user.created_at, t(".created", time: time_ago_in_words(user.created_at)), title: l(user.created_at, format: :long) %>
  <% end %>

  <% if Moduler::Administration::UserPolicy.new(current_user, user).edit? %>
    <% item.with_action do %>
      <%= render(Moduler::ButtonLinkComponent.new(t(".action.edit"), moduler.edit_administration_user_path(user), size: :sm)) %>
    <% end %>
  <% end %>
<% end %>
