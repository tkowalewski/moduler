<%= render(Moduler::Administration::PageComponent.new) do %>
  <%= render(Moduler::PageHeaderComponent.new(t(".title"), description: t(".description"))) do |header| %>
    <% header.with_action do %>
      <%= render(Moduler::ButtonLinkComponent.new(t(".action.new"), moduler.new_administration_user_path)) %>
    <% end %>
  <% end %>

  <%= render(Moduler::FilterComponent.new(@filter, moduler.administration_users_path)) %>

  <%= render(Moduler::ListComponent.new(@users, id: "users", empty: t(".empty"))) do %>
    <%= render partial: "moduler/administration/users/user", collection: @users %>
  <% end %>
<% end %>
