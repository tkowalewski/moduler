<main class="mx-auto flex w-full flex-1 max-w-[120rem] flex-col gap-4 px-4 md:flex-row md:gap-8 md:pl-0 md:pr-6">
  <%= render "moduler/common/administration/sidebar" %>

  <div class="flex min-w-0 flex-1 flex-col pb-4 md:mt-8">

    <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <h1 class="text-base font-semibold text-gray-900"><%= t(".title") %></h1>
      </div>

      <%= link_to t(".action.new"), moduler.profile_sessions_revocation_path,
            class: "cursor-pointer whitespace-nowrap rounded-md bg-white px-3 py-1.5 text-sm/6 font-semibold text-green-600 shadow-sm ring-1 ring-inset ring-slate-300 hover:bg-green-50 hover:ring-green-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-600"
      %>
    </div>

    <%= form_with model: @filter, url: moduler.administration_users_path, method: :get,
          scope: :filter, data: { turbo: false }, class: "flex flex-wrap items-end gap-3" do |form| %>
      <div class="min-w-48 flex-1">
        <%= form.text_field :query, placeholder: t(".placeholder.query"), autocomplete: "off",
              class: "w-full rounded-md border border-slate-300 px-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900" %>
      </div>

      <%= form.submit t(".action.filter"),
            class: "cursor-pointer whitespace-nowrap rounded-md bg-white px-3 py-2 text-sm/6 font-semibold text-custom ring-1 ring-inset ring-slate-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-custom" %>
      <% if @filter.query.present? %>
        <%= link_to t(".action.clear"), moduler.administration_users_path, class: "flex h-10 items-center text-sm text-slate-500 hover:text-slate-900" %>
      <% end %>
    <% end %>

    <div class="flex-1">
      <%= render partial: "moduler/administration/users/user", collection: @users %>
    </div>

    <div class="mt-4 flex justify-end">
      <%= paginate @users %>
    </div>

  </div>
</main>
