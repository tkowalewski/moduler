<%= render(Moduler::Administration::PageComponent.new) do %>
  <%= render(Moduler::PageHeaderComponent.new(t(".title"))) %>

  <%= form_with model: @user, url: moduler.administration_user_path(@user), method: :patch, data: { turbo: false }, class: "w-full max-w-lg space-y-6" do |form| %>
    <%= render(::Moduler::Form::BaseErrorComponent.new(form)) %>

    <%= render(::Moduler::Form::SectionComponent.new(t(".section.data"))) do %>
      <%= render(::Moduler::Form::EmailComponent.new(form, :email_address, label: t(".label.email_address"))) %>
      <%= render(::Moduler::Form::TextComponent.new(form, :name, label: t(".label.name"), description: t(".description.name"))) %>
      <%= render(::Moduler::Form::SelectComponent.new(form, :role, Moduler::User.roles.keys.map { |role| [ t("moduler.administration.users.roles.#{role}"), role ] }, label: t(".label.role"))) %>
      <%= render(::Moduler::Form::SelectComponent.new(form, :status, Moduler::User.statuses.keys.map { |status| [ t("moduler.administration.users.statuses.#{status}"), status ] }, label: t(".label.status"))) %>
    <% end %>

    <%= render(::Moduler::Form::SubmitComponent.new(form, text: t(".action.save"))) %>
  <% end %>
<% end %>
