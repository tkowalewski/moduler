<%= render(Moduler::Administration::PageComponent.new) do %>
  <%= render(Moduler::PageHeaderComponent.new(t(".title"), description: t(".description"))) do |header| %>
    <% header.with_action do %>
      <%= render(Moduler::ButtonLinkComponent.new(t(".action.new"), moduler.new_administration_document_path)) %>
    <% end %>
  <% end %>

  <%= render(Moduler::FilterComponent.new(@filter, moduler.administration_documents_path)) %>

  <%= render(Moduler::ListComponent.new(@documents, id: "documents", empty: t(".empty"))) do %>
    <%= render partial: "moduler/administration/documents/document", collection: @documents %>
  <% end %>
<% end %>
