<%= render(Moduler::ListItemComponent.new(document.name, id: dom_id(document))) do |item| %>
  <% item.with_badge(t("moduler.administration.documents.kinds.#{document.kind}")) %>

  <% item.with_meta do %>
    <%= time_tag document.created_at, t(".created", time: time_ago_in_words(document.created_at)), title: l(document.created_at, format: :long) %>
  <% end %>

  <% if document.file.attached? %>
    <% item.with_action do %>
      <%= render(Moduler::ButtonLinkComponent.new(t(".action.download"), main_app.rails_blob_path(document.file, disposition: "attachment"), size: :sm)) %>
    <% end %>
  <% end %>

  <% if Moduler::Administration::DocumentPolicy.new(current_user, document).edit? %>
    <% item.with_action do %>
      <%= render(Moduler::ButtonLinkComponent.new(t(".action.edit"), moduler.edit_administration_document_path(document), size: :sm)) %>
    <% end %>
  <% end %>
<% end %>
