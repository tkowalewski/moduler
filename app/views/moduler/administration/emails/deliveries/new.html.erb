<%= render(Moduler::Administration::PageComponent.new) do %>
  <%= render(Moduler::PageHeaderComponent.new(t(".title", subject: @email.subject), description: t(".description"))) %>

  <%= render(Moduler::FilterComponent.new(@filter, moduler.new_administration_email_delivery_path(@email), selects: [
        { name: :role, choices: Moduler::User.roles.keys.map { |role| [ t("moduler.administration.users.roles.#{role}"), role ] }, prompt: t(".placeholder.role") },
        { name: :sent, choices: [ [ t(".sent.true"), "true" ], [ t(".sent.false"), "false" ] ], prompt: t(".placeholder.sent") },
        { name: :per_page, choices: EmailDeliveryFilter::PER_PAGE.map { |per_page| [ t(".per_page", count: per_page), per_page ] }, prompt: false }
      ])) %>

  <%= form_with url: moduler.administration_email_deliveries_path(@email), data: { turbo: false, controller: "select-all" } do |form| %>
    <% if @users.any? %>
      <div class="mt-6">
        <label class="flex items-center gap-3 px-4 text-sm text-slate-500 sm:px-5">
          <input type="checkbox" data-select-all-target="parent" data-action="change->select-all#toggleChildren" class="h-4 w-4 cursor-pointer rounded border-gray-300 accent-custom">
          <%= t(".action.select_all") %>
        </label>
      </div>
    <% end %>

    <%= render(Moduler::ListComponent.new(@users, id: "users", empty: t(".empty"))) do %>
      <% @users.each do |user| %>
        <li id="<%= dom_id(user) %>" class="flex items-center gap-3 px-4 py-4 sm:px-5">
          <% if user.user_email_id %>
            <input type="checkbox" checked disabled aria-label="<%= user.email_address %>" class="h-4 w-4 shrink-0 rounded border-gray-300 accent-custom">
          <% else %>
            <input type="checkbox" name="user_ids[]" value="<%= user.id %>" id="user_ids_<%= user.id %>"
                  data-select-all-target="child" data-action="change->select-all#toggleParent"
                  class="h-4 w-4 shrink-0 cursor-pointer rounded border-gray-300 accent-custom">
          <% end %>

          <div class="min-w-0 flex-1">
            <label for="user_ids_<%= user.id %>" class="flex flex-wrap items-center gap-2">
              <span class="truncate text-sm font-semibold text-gray-900"><%= user.display_name %></span>
              <%= render(Moduler::BadgeComponent.new(t("moduler.administration.users.roles.#{user.role}"))) %>
            </label>
            <p class="mt-1 text-xs text-slate-400">
              <% if user.name.present? %>
                <%= user.email_address %>
                <span aria-hidden="true">&middot;</span>
              <% end %>
              <% if user.user_email_sent_at %>
                <%= t(".status.sent", time: l(user.user_email_sent_at, format: :long)) %>
              <% elsif user.user_email_id %>
                <%= t(".status.queued") %>
              <% else %>
                <%= t(".status.not_sent") %>
              <% end %>
            </p>
          </div>
        </li>
      <% end %>
    <% end %>

    <% if @users.any? %>
      <%= render(::Moduler::Form::SubmitComponent.new(form, text: t(".action.submit"))) %>
    <% end %>
  <% end %>
<% end %>
