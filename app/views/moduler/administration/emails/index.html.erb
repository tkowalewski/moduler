<%= render(Moduler::Administration::PageComponent.new) do %>
  <%= render(Moduler::PageHeaderComponent.new(t(".title"), description: t(".description"))) do |header| %>
    <% header.with_action do %>
      <%= render(Moduler::ButtonLinkComponent.new(t(".action.new"), moduler.new_administration_email_path)) %>
    <% end %>
  <% end %>

  <%= render(Moduler::FilterComponent.new(@filter, moduler.administration_emails_path)) %>

  <%= render(Moduler::ListComponent.new(@emails, id: "emails", empty: t(".empty"))) do %>
    <%= render partial: "moduler/administration/emails/email", collection: @emails %>
  <% end %>
<% end %>
