<%= render(Moduler::ListItemComponent.new(membership.user.email_address, id: dom_id(membership))) do |item| %>
  <% item.with_badge(membership.organization.name) %>
  <% item.with_badge(membership.role.name, variant: :muted) %>

  <% item.with_meta do %>
    <%= time_tag membership.created_at, t(".created", time: time_ago_in_words(membership.created_at)), title: l(membership.created_at, format: :long) %>
  <% end %>

  <% policy = Moduler::Administration::MembershipPolicy.new(current_user, membership) %>

  <% if policy.edit? %>
    <% item.with_action do %>
      <%= render(Moduler::ButtonLinkComponent.new(t(".action.edit"), moduler.edit_administration_membership_path(membership), size: :sm)) %>
    <% end %>
  <% end %>

  <% if policy.destroy? %>
    <% item.with_action do %>
      <%= render(Moduler::ButtonComponent.new(t(".action.destroy"), moduler.administration_membership_path(membership), method: :delete, size: :sm,
            confirm: t(".confirmation.destroy", email_address: membership.user.email_address, organization: membership.organization.name))) %>
    <% end %>
  <% end %>
<% end %>
