<%= render(Moduler::Administration::PageComponent.new) do %>
  <%= render(Moduler::PageHeaderComponent.new(t(".title"), description: t(".description"))) do |header| %>
    <% header.with_action do %>
      <%= render(Moduler::ButtonLinkComponent.new(t(".action.new"), moduler.new_administration_preference_path)) %>
    <% end %>
  <% end %>

  <%= render(Moduler::FilterComponent.new(@filter, moduler.administration_preferences_path, placeholder: t(".placeholder.query"))) %>

  <%= render(Moduler::ListComponent.new(@preferences, id: "preferences", empty: t(".empty"))) do %>
    <%= render partial: "moduler/administration/preferences/preference", collection: @preferences %>
  <% end %>
<% end %>
