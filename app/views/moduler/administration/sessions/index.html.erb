<%= render(Moduler::Administration::PageComponent.new) do %>
  <%= render(Moduler::PageHeaderComponent.new(t(".title"), description: t(".description"))) %>

  <%= render(Moduler::FilterComponent.new(@filter, moduler.administration_sessions_path)) %>

  <%= render(Moduler::ListComponent.new(@sessions, id: "sessions", empty: t(".empty"))) do %>
    <%= render partial: "moduler/administration/sessions/session", collection: @sessions %>
  <% end %>
<% end %>
