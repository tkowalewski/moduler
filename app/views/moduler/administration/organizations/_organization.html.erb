<%= render(Moduler::ListItemComponent.new(organization.name, id: dom_id(organization))) do |item| %>
  <% item.with_meta do %>
    <%= time_tag organization.created_at, t(".created", time: time_ago_in_words(organization.created_at)), title: l(organization.created_at, format: :long) %>
  <% end %>

  <% if Moduler::Administration::MembershipPolicy.new(current_user, Moduler::Membership).index? %>
    <% item.with_action do %>
      <%= render(Moduler::ButtonLinkComponent.new(t(".action.memberships"), moduler.administration_memberships_path(filter: { organization_id: organization.id }), size: :sm)) %>
    <% end %>
  <% end %>

  <% if Moduler::Administration::RolePolicy.new(current_user, Moduler::Role).index? %>
    <% item.with_action do %>
      <%= render(Moduler::ButtonLinkComponent.new(t(".action.roles"), moduler.administration_roles_path(filter: { organization_id: organization.id }), size: :sm)) %>
    <% end %>
  <% end %>

  <% if Moduler::Administration::OrganizationPolicy.new(current_user, organization).edit? %>
    <% item.with_action do %>
      <%= render(Moduler::ButtonLinkComponent.new(t(".action.edit"), moduler.edit_administration_organization_path(organization), size: :sm)) %>
    <% end %>
  <% end %>
<% end %>
