<%= render(Moduler::Administration::PageComponent.new) do %>
  <%= render(Moduler::PageHeaderComponent.new(t(".title"), description: t(".description"))) do |header| %>
    <% header.with_action do %>
      <%= render(Moduler::ButtonLinkComponent.new(t(".action.new"), moduler.new_administration_organization_path)) %>
    <% end %>
  <% end %>

  <%= render(Moduler::FilterComponent.new(@filter, moduler.administration_organizations_path)) %>

  <%= render(Moduler::ListComponent.new(@organizations, id: "organizations", empty: t(".empty"))) do %>
    <%= render partial: "moduler/administration/organizations/organization", collection: @organizations %>
  <% end %>
<% end %>
