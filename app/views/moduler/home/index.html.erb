<main class="mx-auto flex w-full max-w-2xl flex-1 flex-col px-4 py-8">
  <div class="mb-6">
    <h1 class="text-base font-semibold text-gray-900"><%= t(".title", name: current_user.display_name) %></h1>
    <p class="mt-1 text-sm text-slate-500"><%= t(@memberships.any? ? ".description" : ".empty") %></p>
  </div>

  <% if @memberships.any? %>
    <ul id="organizations" class="divide-y divide-gray-200 rounded-md border border-gray-200 bg-white">
      <% @memberships.each do |membership| %>
        <li id="<%= dom_id(membership.organization) %>">
          <%= link_to moduler.organization_path(membership.organization), class: "flex items-center justify-between gap-3 px-4 py-4 hover:bg-slate-50 sm:px-5" do %>
            <span class="min-w-0">
              <span class="block truncate text-sm font-medium text-gray-900"><%= membership.organization.name %></span>
              <span class="mt-1 block text-xs text-slate-400"><%= membership.role.name %></span>
            </span>
            <svg class="size-4 shrink-0 text-slate-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
            </svg>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</main>
